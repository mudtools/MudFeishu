<Project>
	<PropertyGroup>
		<Version>3.0.1</Version>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<NoDefaultExcludes>true</NoDefaultExcludes>
		<!-- 示例工程一律不可打包：CI 用 `dotnet pack Mud.Feishu.slnx` 打包（解决方案含 Demos），
		     未关闭打包的示例工程会被打成包并静默推到 nuget.org（包名同样命中信任策略的
		     Mud.Feishu* glob，不会被拒绝）。Mud.Feishu.AotVerification 就属于这种漏网项目。
		     Web SDK 项目（Microsoft.NET.Sdk.Web）自带 IsPackable=false，但 Microsoft.NET.Sdk
		     的控制台/测试类项目默认为 true，故必须在遮蔽根 Directory.Build.props 的本文件里显式关闭。 -->
		<IsPackable>false</IsPackable>
		<Copyright>© 2019-2025 Mud Studio Co.,Ltd.</Copyright>
		<Authors>Mud Studio</Authors>
		<Company>Mud Studio</Company>
		<LangVersion>13.0</LangVersion>
		<!-- 本文件会遮蔽仓库根的 Directory.Build.props，故此处显式继承治理设置，避免示例项目成为门禁盲区 -->
		<NoWarn>$(NoWarn);NU1605</NoWarn>
		<WarningsNotAsErrors>$(WarningsNotAsErrors);NU1605</WarningsNotAsErrors>
		<WarningsAsErrors>$(WarningsAsErrors);NU1603</WarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net6.0'">
		<NoWarn>$(NoWarn);AOT006</NoWarn>
		<WarningsNotAsErrors>$(WarningsNotAsErrors);AOT006</WarningsNotAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>
</Project>
