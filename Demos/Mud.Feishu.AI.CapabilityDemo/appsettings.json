{
  // ─────────────────────────────────────────────────────────────────────────────
  // Mud.Feishu.AI.CapabilityDemo 配置模板（可提交；**不要**在此填真实密钥）
  //
  // 配置来源（高 → 低，全部来自配置文件，不读环境变量）：
  //   ① appsettings.local.json（本地覆盖；已被 .gitignore 忽略 —— 真实密钥写这里）
  //   ② appsettings.json（本文件，随产物复制）
  //
  // 本工程**不提供 FeishuAgent 节**：白名单/风险/身份/策略模式的唯一真相源是代码
  // （Host/ActProfile.cs + Common/ToolSets.cs），`--verify` 的 config-template 组会断言
  // 该节不存在，防止出现"同一选项两个真相源"。
  // ─────────────────────────────────────────────────────────────────────────────

  "FeishuCapabilityDemo": {
    // 模型（A1/A3/A5/A8 需要；A2/A4/A6/A7/--verify 完全不需要）
    "ModelId": "qwen3.8-flash",
    "ApiKey": "",
    "Endpoint": "https://llm-uctwuagrcutdr7gd.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",

    // 单应用凭证（A1/A3/A4/A5/A6 需要；只填 appsettings.local.json）
    "AppKey": "cap-demo",
    "AppId": "",
    "AppSecret": "",

    // 会话键 subject 段（不是真实 open_id）
    "UserId": "ou_cap_demo_user",

    // A5：目标多维表格（app_token 取 /base/ 后一段；table_id 取 ?table=tbl...）
    "BitTableAppToken": "",
    "BitTableTableId": "",

    // 授权策略：strict（默认）/ ask / readonly
    "Policy": "strict",

    // /export 默认落盘路径（留空 = %TEMP%/cap-demo-audit-{ts}.jsonl）
    "AuditExportPath": "",

    // A7 默认展开的域
    "SkillDomain": "bitable"
  },

  // ─────────────────────────────────────────────────────────────────────────────
  // A8 多租户需要两个应用：把下面注释解开并填两个真实自建应用（只填 local）；
  // 缺该节时单应用幕会由 FeishuCapabilityDemo 凭证合成单应用，A8 会直接给出提示并退出。
  //
  // "FeishuApps": [
  //   { "AppKey": "app-a", "AppId": "cli_***", "AppSecret": "***", "IsDefault": true },
  //   { "AppKey": "app-b", "AppId": "cli_***", "AppSecret": "***" }
  // ],
  // ─────────────────────────────────────────────────────────────────────────────

  // 运行时日志：控制台只收 Warning（不干扰 REPL），文件全量。
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Warning"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cap-demo-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}
