{
  // ─────────────────────────────────────────────────────────────────────────────
  // Mud.Feishu.Agent.Demo 配置模板（可提交；**不要**在此填真实密钥）
  //
  // 配置来源（高 → 低，**全部来自配置文件，环境变量不再参与**）：
  //   ① appsettings.local.json（本地覆盖；已被 .gitignore 忽略 —— 真实密钥写这里）
  //   ② appsettings.json（本文件，随产物复制）
  //
  // 运行模式**由启动菜单选择**（裸模型 / 工具冒烟 / IM 接入 / 领域事件 / 文档智能体 / Skills 产物）：
  // 程序启动后打印菜单，用户输入编号或标识进入对应模块（q 退出）。
  // 本文件里的 Enabled 键**不再决定进入哪个模式**，只决定菜单的**默认项**（回车采用的项），
  // 按下面顺序取第一个 Enabled=true 的模式；均不启用时默认项是菜单首项（裸模型）：
  //   ① FeishuToolsDemo:Enabled        = true → 默认项 = 工具冒烟（全域只读工具）
  //   ② FeishuImHandlerDemo:Enabled    = true → 默认项 = IM 会话处理器接入演示
  //   ③ FeishuDomainEventsDemo:Enabled = true → 默认项 = 领域事件处理器 + 流式通道降级链（R-13）
  //   ④ FeishuDocAgent:Enabled         = true → 默认项 = 文档业务智能体控制台（模板默认）
  //   ⑤ FeishuSkillsDemo:Enabled       = true → 默认项 = Skills 产物消费演示
  //
  // 模型与飞书凭证**统一写在 FeishuDemo 节**（共享参数只此一处）；
  // 各模式节只保留自己的默认项开关与专属参数。真实密钥只填 appsettings.local.json。
  // ─────────────────────────────────────────────────────────────────────────────

  // ─────────────────────────────────────────────────────────────────────────────
  // 统一连接配置：模型三项 + 飞书自建应用凭证（各模式共用，只在此处写一次）。
  // ApiKey / AppId / AppSecret 只填 appsettings.local.json（本模板留空）。
  // ─────────────────────────────────────────────────────────────────────────────
  "FeishuDemo": {
    // 模型 ID（必填；如 "glm-4-flash"）
    "ModelId": "qwen3.8-flash",

    // 模型 API Key（必填；**只填在 appsettings.local.json**）
    "ApiKey": "",

    // OpenAI-compatible 端点（可选；留空 = SDK 默认端点。须 HTTPS，环回地址例外）
    "Endpoint": "https://llm-uctwuagrcutdr7gd.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",

    // 飞书自建应用凭证（工具冒烟 / 文档智能体必填；**只填在 appsettings.local.json**）
    "AppId": "",
    "AppSecret": ""
  },

  "FeishuDocAgent": {
    // 默认项开关：true = 文档业务智能体是启动菜单的默认项（回车即进入；模板默认 true）
    "Enabled": true,

    // 应用键与会话身份（可选；应用键不得含 ':'）
    "AppKey": "demo-app",
    "UserId": "ou_console_demo_user",

    // 剧本 S1（知识库体检）的空间 ID（可选；留空则引导模型自行列出空间）
    "WikiSpaceId": "",

    // 初始授权策略：strict（默认，高风险写工具被独立拒绝）/ ask / readonly
    "Policy": "strict",

    // 摘要触发条数阈值（可选；0 = 禁用摘要，或 ≥ 4）
    "SummaryThreshold": 30,

    // /export 的默认落盘路径（可选；留空 = 运行时生成 %TEMP% 路径）
    "AuditExportPath": "",

    // drive.upload_file 的附件大小上限（MB）
    "AttachmentMaxMb": 25
  },

  // ─────────────────────────────────────────────────────────────────────────────
  // 工具冒烟：全域只读工具 + 飞书客户端（write 白名单默认关闭）。
  // 模型/飞书凭证统一读 FeishuDemo 节；StreamChatId 可选（提供后走流式通道）。
  // ─────────────────────────────────────────────────────────────────────────────
  "FeishuToolsDemo": {
    // 默认项开关（true = 本模式成为启动菜单的默认项；进入模式本身由菜单选择决定）
    "Enabled": false,
    "StreamChatId": ""
  },

  // ─────────────────────────────────────────────────────────────────────────────
  // P2D-5a「零自定义接入」演示：内置 IM 会话事件处理器一行接入（注册面冒烟）。
  // 模型三项统一读 FeishuDemo 节；飞书多应用由宿主在 WebSocket/Webhook 通道另行配置。
  // ─────────────────────────────────────────────────────────────────────────────
  "FeishuImHandlerDemo": {
    // 默认项开关（同上）
    "Enabled": false
  },

  // ─────────────────────────────────────────────────────────────────────────────
  // 领域事件演示：三个领域会话处理器（审批 / 多维表格记录变更 / 任务更新）
  // + 上下文装配器 + 流式通道降级链的真实调用点。事件载荷由代码构造并直接派发。
  // 模型与飞书凭证统一读 FeishuDemo 节；StreamChatId 可选（提供后走流式链路一节）。
  // ─────────────────────────────────────────────────────────────────────────────
  "FeishuDomainEventsDemo": {
    // 默认项开关（同上）
    "Enabled": false,
    "StreamChatId": ""
  },

  // ─────────────────────────────────────────────────────────────────────────────
  // Skills 产物消费演示：读包内 skills/** 并注入域 guidance。
  // 本模式不连飞书、不需要模型；Domain 可选（留空 = im —— 工具面最大、guidance 最长）。
  // ─────────────────────────────────────────────────────────────────────────────
  "FeishuSkillsDemo": {
    // 默认项开关（同上）
    "Enabled": false,
    "Domain": "im"
  },

  // ─────────────────────────────────────────────────────────────────────────────
  // 运行时日志（R5 治理：级别唯一事实源是配置，不设「日志开关」属性）。
  // 本节存在时为唯一事实源（Common/DemoLogging.ReadFrom.Configuration）；
  // 删除本节时代码兜底同形态（控制台 Warning / 文件全量 Information）。
  // 调 SDK 内部日志：把对应类别 Override 到 Debug/Information，看 logs/ 下文件即可。
  // ─────────────────────────────────────────────────────────────────────────────
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        // 控制台只收 Warning+：不干扰 REPL / 模型流式输出。
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Warning"
        }
      },
      {
        // 文件收全量：按天滚动（logs/agent-demo-20260101.log），10 MB 上限，保留 7 个。
        "Name": "File",
        "Args": {
          "path": "logs/agent-demo-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}
