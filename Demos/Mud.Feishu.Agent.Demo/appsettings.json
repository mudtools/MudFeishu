{
  // ─────────────────────────────────────────────────────────────────────────────
  // Mud.Feishu.Agent.Demo 配置模板（可提交；**不要**在此填真实密钥）
  //
  // 配置来源与优先级（高 → 低）：
  //   ① 环境变量（FEISHU_*，见 README §3）
  //   ② appsettings.local.json（本地覆盖；已被 .gitignore 忽略 —— 真实密钥写这里）
  //   ③ appsettings.{DOTNET_ENVIRONMENT}.json（可选，与仓库其他 Demo 同约定）
  //   ④ appsettings.json（本文件）
  //
  // 启用文档业务智能体模式：`"Enabled": true`（等价于环境变量 FEISHU_DEMO_DOC_AGENT=1；
  // 环境变量一旦设置就按它判定，可用来临时关掉文件里的开关）。
  // 其余三个模式的开关仍是环境变量（FEISHU_DEMO_TOOLS / FEISHU_DEMO_IM_HANDLER）。
  // ─────────────────────────────────────────────────────────────────────────────
  "FeishuDocAgent": {
    // 模式开关：true = 进入文档业务智能体控制台（等价 FEISHU_DEMO_DOC_AGENT=1）
    "Enabled": false,

    // 模型 ID（必填；如 "glm-4-flash"）
    "ModelId": "",

    // 模型 API Key（必填；**只填在 appsettings.local.json**）
    "ApiKey": "",

    // OpenAI-compatible 端点（可选；留空 = SDK 默认端点。须 HTTPS，环回地址例外）
    "Endpoint": "",

    // 飞书自建应用凭证（必填；**只填在 appsettings.local.json**）
    "AppId": "",
    "AppSecret": "",

    // 应用键与会话身份（可选；应用键不得含 ':'）
    "AppKey": "demo-app",
    "UserId": "ou_console_demo_user",

    // 剧本 S1（知识库体检）的空间 ID（可选；留空则引导模型自行列出空间）
    "WikiSpaceId": "",

    // 初始授权策略：strict（默认，高风险写工具被独立拒绝）/ ask / readonly
    "Policy": "strict",

    // 摘要触发条数阈值（可选；0 = 禁用摘要，或 ≥ 4）
    "SummaryThreshold": 30,

    // /export 的默认落盘路径（可选；留空 = 运行时生成 %TEMP% 路径）
    "AuditExportPath": "",

    // drive.upload_file 的附件大小上限（MB）
    "AttachmentMaxMb": 25
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // 可选：把飞书应用写成 SDK 的 FeishuApps 数组（与上面的 AppId/AppSecret 等价）。
  // 两者同时存在时，FeishuApps 优先（上面的配置仅作为回退）。
  //
  // "FeishuApps": [
  //   { "AppKey": "demo-app", "AppId": "cli_xxx", "AppSecret": "xxx", "IsDefault": true }
  // ]
  // ─────────────────────────────────────────────────────────────────────────────
}
