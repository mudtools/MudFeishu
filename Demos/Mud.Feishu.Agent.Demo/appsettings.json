{
  // ─────────────────────────────────────────────────────────────────────────────
  // Mud.Feishu.Agent.Demo 配置模板（可提交；**不要**在此填真实密钥）
  //
  // 配置来源（高 → 低，**全部来自配置文件，环境变量不再参与**）：
  //   ① appsettings.local.json（本地覆盖；已被 .gitignore 忽略 —— 真实密钥写这里）
  //   ② appsettings.json（本文件，随产物复制）
  //
  // 四个运行模式（互斥，按下面顺序判定，命中即返回）：
  //   ① FeishuToolsDemo:Enabled     = true  → 工具冒烟（全域只读工具）
  //   ② FeishuImHandlerDemo:Enabled = true  → IM 会话处理器接入演示
  //   ③ FeishuDocAgent:Enabled      = true  → 文档业务智能体控制台
  //   ④ 均不启用                            → Phase 0 裸模型一问一答（读 FeishuChatDemo）
  //
  // 每个模式各自的模型/飞书凭证都写在自己那一节；真实密钥只填 appsettings.local.json。
  // ─────────────────────────────────────────────────────────────────────────────
  "FeishuDocAgent": {
    // 模式开关：true = 进入文档业务智能体控制台
    "Enabled": false,

    // 模型 ID（必填；如 "glm-4-flash"）
    "ModelId": "qwen3.8-flash",

    // 模型 API Key（必填；**只填在 appsettings.local.json**）
    "ApiKey": "",

    // OpenAI-compatible 端点（可选；留空 = SDK 默认端点。须 HTTPS，环回地址例外）
    "Endpoint": "https://llm-uctwuagrcutdr7gd.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",

    // 飞书自建应用凭证（必填；**只填在 appsettings.local.json**）
    "AppId": "",
    "AppSecret": "",

    // 应用键与会话身份（可选；应用键不得含 ':'）
    "AppKey": "demo-app",
    "UserId": "ou_console_demo_user",

    // 剧本 S1（知识库体检）的空间 ID（可选；留空则引导模型自行列出空间）
    "WikiSpaceId": "",

    // 初始授权策略：strict（默认，高风险写工具被独立拒绝）/ ask / readonly
    "Policy": "strict",

    // 摘要触发条数阈值（可选；0 = 禁用摘要，或 ≥ 4）
    "SummaryThreshold": 30,

    // /export 的默认落盘路径（可选；留空 = 运行时生成 %TEMP% 路径）
    "AuditExportPath": "",

    // drive.upload_file 的附件大小上限（MB）
    "AttachmentMaxMb": 25
  },

  // ─────────────────────────────────────────────────────────────────────────────
  // Phase 1/2 工具冒烟：全域只读工具 + 飞书客户端（write 白名单默认关闭）。
  // 模型/飞书凭证均为必填（裸模型 + 租户身份）；StreamChatId 可选（提供后走流式通道）。
  // ─────────────────────────────────────────────────────────────────────────────
  "FeishuToolsDemo": {
    "Enabled": false,
    "ModelId": "",
    "ApiKey": "",
    "Endpoint": "",
    "AppId": "",
    "AppSecret": "",
    "StreamChatId": ""
  },

  // ─────────────────────────────────────────────────────────────────────────────
  // P2D-5a「零自定义接入」演示：内置 IM 会话事件处理器一行接入（注册面冒烟）。
  // 只需模型三项；飞书多应用由宿主在 WebSocket/Webhook 通道另行配置。
  // ─────────────────────────────────────────────────────────────────────────────
  "FeishuImHandlerDemo": {
    "Enabled": false,
    "ModelId": "",
    "ApiKey": "",
    "Endpoint": ""
  },

  // ─────────────────────────────────────────────────────────────────────────────
  // Phase 0 裸模型一问一答（默认模式，无开关）。只需模型三项。
  // ─────────────────────────────────────────────────────────────────────────────
  "FeishuChatDemo": {
    "ModelId": "",
    "ApiKey": "",
    "Endpoint": ""
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // 可选：把飞书应用写成 SDK 的 FeishuApps 数组（与 FeishuDocAgent 节的 AppId/AppSecret 等价）。
  // 两者同时存在时，FeishuApps 优先（上面的配置仅作为回退）。
  //
  // "FeishuApps": [
  //   { "AppKey": "demo-app", "AppId": "cli_xxx", "AppSecret": "xxx", "IsDefault": true }
  // ]
  // ─────────────────────────────────────────────────────────────────────────────
}