{
  "Urls": "http://localhost:52101",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Mud.Feishu.WebSocket": "Information"
    }
  },
  "AllowedHosts": "*",
  "FeishuApps": [
    {
      "AppKey": "default",
      "AppId": "cli_fdafadsfads",
      "AppSecret": "",
      "BaseUrl": "https://open.feishu.cn",
      "TimeOut": 30,
      "RetryCount": 3,
      "RetryDelayMs": 1000,
      "EnableLogging": true,
      "IsDefault": true
    }
  ],
  "FeishuWebSocket": {
    "AutoReconnect": true,
    "MaxReconnectAttempts": 5,
    "ReconnectDelayMs": 5000,
    "HeartbeatIntervalMs": 30000,
    "ConnectionTimeoutMs": 10000,
    "InitialReceiveBufferSize": 4096,
    "EnableLogging": false,
    "MessageSizeLimits": {
      "MaxTextMessageSize": 1048576,
      "MaxBinaryMessageSize": 10485760
    },
    "EventDeduplication": {
      "Mode": "Distributed",
      "CacheExpiration": "00:30:00",
      "CleanupInterval": "00:05:00"
    }
  },
  "FeishuRedis": {
    "ServerAddress": "localhost:6379",
    "Password": "letmein",
    "EventCacheExpiration": "1:00:00",
    "NonceTtl": "00:05:00",
    "SeqIdCacheExpiration": "1:00:00",
    "EventKeyPrefix": "feishu:event:",
    "NonceKeyPrefix": "feishu:nonce:",
    "SeqIdKeyPrefix": "feishu:seqid:",
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000,
    "Ssl": false,
    "AllowAdmin": false
  },
  "DemoSettings": {
    "EnableMockEvents": true,
    "MockEventIntervalMs": 10000,
    "EnableSwagger": true
  }
}