{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=TaskManage.db"
  },
  "FeishuApps": [
    {
      "AppKey": "default",
      "AppId": "cli_xxx",
      "AppSecret": "your_app_secret",
      "IsDefault": true,
      "EncryptKey": "your_encrypt_key",
      "VerificationToken": "your_verification_token"
    }
  ],
  "FeishuWebhook": {
    "AutoRegisterEndpoint": true,
    "GlobalRoutePrefix": "webhook/feishu",
    "EnableRequestLogging": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
