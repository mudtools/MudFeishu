{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=TaskManage.db"
  },
  "FeishuApps": [
    {
      "AppKey": "default",
      "AppId": "cli_xxx",
      "AppSecret": "your_app_secret",
      "IsDefault": true,
      "EncryptKey": "your_encrypt_key",
      "VerificationToken": "your_verification_token"
    }
  ],
  "FeishuWebhook": {
    "AutoRegisterEndpoint": true,
    "GlobalRoutePrefix": "webhook/feishu",
    "EnableRequestLogging": true
  },
  "OAuth": {
    "RedirectUri": "http://localhost:5000/api/auth/callback",
    "StateExpirationMinutes": 10,
    "Jwt": {
      "Secret": "your_jwt_secret_key_at_least_32_characters",
      "Issuer": "TaskManageDemo",
      "Audience": "TaskManageDemo.Client",
      "ExpirationMinutes": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
