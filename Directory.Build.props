<Project>
	<PropertyGroup>
		<Version>3.0.0-rc1</Version>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoDefaultExcludes>true</NoDefaultExcludes>
		<Copyright>© 2019-2026 Mud Studio Co.,Ltd.</Copyright>
		<Authors>Mud Studio</Authors>
		<Company>Mud Studio</Company>
		<LangVersion>13.0</LangVersion>
		<NoWarn>$(NoWarn);NU1605</NoWarn>
		<WarningsNotAsErrors>$(WarningsNotAsErrors);NU1605</WarningsNotAsErrors>
		<!-- 版本漂移防护（BLK-1）：声明版本与解析版本不一致时立即失败，避免"声明 2.0.3、编译 2.0.4"的非确定性构建。 -->
		<WarningsAsErrors>$(WarningsAsErrors);NU1603</WarningsAsErrors>
	</PropertyGroup>

<!-- AOT006 仅在启用 AOT 分析的 TFM（net8+）上有语义。
     netstandard2.0 / net6.0 不启用 IsAotCompatible（见上方条件），且脚手架生成的 JsonSerializerContext
     由 #if NET8_0_OR_GREATER 包裹而不参与编译，[HttpJsonSerializable] 却在任何 TFM 都存在，
     因此这两个 TFM 上 AOT006 是纯噪音（实测各 3740 条），按 TFM 精确豁免。
     WarningsNotAsErrors 必须同时设置：组件 targets 在 AotStrictMode=true 下会把 AOT006 提升为 error。 -->
<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net6.0'">
    <NoWarn>$(NoWarn);AOT006</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);AOT006</WarningsNotAsErrors>
</PropertyGroup>

<!-- AOT 全局配置：仅在 .NET 8+ TFM 上启用 AOT 分析器。 -->
<PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0' AND '$(TargetFramework)' != 'net6.0'">
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TrimMode>full</TrimMode>
    <WarningsAsErrors>$(WarningsAsErrors);AOT001;AOT002;AOT003;AOT004;AOT007</WarningsAsErrors>
    <!-- AOT-3：ConfigurationBinder.Bind / Configure<T>(IConfiguration) 的反射实现会触发 IL2026/IL3050。
         启用配置绑定源生成器后，绑定代码在编译期生成，消除这两类告警。 -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
</PropertyGroup>

<!-- 严格模式（可选）：将 IL2xxx/IL3xxx/AOT00x 升级为错误 -->
<PropertyGroup Condition="'$(AotStrictMode)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2050;IL2057;IL2067;IL2070;IL2072;IL2075;IL2080;IL3050</WarningsAsErrors>
</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0'or '$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.Text.Json" Version="10.0.9" />
	</ItemGroup>	
</Project>
