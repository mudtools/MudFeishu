<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<Description>Mud.AI 工具面源生成引擎（ToolSurface 竖井）：把 [SdkToolProfile] 剖面驱动的工具特性接口编译为「模型可调用工具」的全部编译期产物（Schema/golden、Args 解包器、域注册器、能力目录、guidance/affordance 资产）。v2.3 自组件仓 Mud.HttpUtils.Generator 迁入飞书仓（调优期仓内闭环，P3 上游化），命名空间 Mud.HttpUtils.* → Mud.AI.*。</Description>
		<PackageTags>Mud.AI;ToolSurface;Roslyn;SourceGenerator;Analyzer;AI;Agent;Tools;MudFeishu</PackageTags>
		<Product>Mud AI Tool Surface Generator</Product>
		<PackageId>Mud.AI.Generator</PackageId>
		<AssemblyName>Mud.AI.Generator</AssemblyName>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsRoslynComponent>true</IsRoslynComponent>
		<AnalysisLevel>6.0-all</AnalysisLevel>
		<!-- 不将构建输出打包到 lib/ 目录，仅通过 analyzers/ 路径分发 -->
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<!-- 本工程是 netstandard2.0 单 TFM：根 Directory.Build.props 的 AOT 属性条件在
		     单 TFM 工程求值时 $(TargetFramework) 尚为空（多 TFM 工程靠内层构建的 GlobalProperty 生效），
		     会误设 IsAotCompatible 触发 NETSDK1210。此处按工程显式关闭（Roslyn 组件不需要 AOT 分析器）。 -->
		<IsAotCompatible>false</IsAotCompatible>
		<EnableAotAnalyzer>false</EnableAotAnalyzer>
		<EnableTrimAnalyzer>false</EnableTrimAnalyzer>
		<!-- CA1031：本程序集是 Roslyn 源生成器 / 诊断分析器，运行在编译器进程内。
		     任何逸出到 csc 的异常都会让宿主编译直接失败（IDE 表现为"生成器崩溃"），
		     因此所有 Safe*/Try*/Execute* 包装必须吞掉一切异常并转为诊断或静默兜底 ——
		     这是 Roslyn 生成器的硬性设计要求，而非可收窄的宽泛捕获。
		     RS1035：ShouldSkipGeneratedValidation 读环境变量是 [Conditional("DEBUG")] 验证开关的
		     唯一稳定通道（MSBuild 属性在 DEBUG 剥离点无消费点），与组件仓同款登记。
		     CA1707/CA1021/CA1822：与组件仓 Mud.HttpUtils.Generator 根 props 同款的既有豁免。 -->
		<NoWarn>$(NoWarn);CA1031;RS1035;CA1707;CA1021;CA1822</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- 说明：本工程【不得】引用 Microsoft.CodeAnalysis.CSharp.Workspaces。
		     编译器扩展（源生成器 / DiagnosticAnalyzer）会被 csc 在命令行编译时加载，
		     而命令行编译进程不提供 Workspaces 程序集；一旦引用，RS1038 会告警且行为不可预测。 -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.AI.Generator.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- 诊断发布跟踪（消除 RS2008）：登记全部静态 DiagnosticDescriptor 的 ID/类别/级别。
		     未登记的新规则 → RS2008；已登记但类别/级别漂移 → RS001。
		     注意：剖面注入的动态 {prefix}{slot} 诊断（MUDFT*）由 ToolSurfaceDiagnostics 槽位表
		     运行时构造，不是静态描述符，故不进入本发布跟踪表。 -->
		<AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
		<AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
	</ItemGroup>

</Project>
