<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Mud.Feishu.AI.Mcp</AssemblyName>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageProjectUrl>http://www.mudtools.cn/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mudtools/MudFeishu</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>Icon.png</PackageIcon>
		<BaseOutputPath>..\bin</BaseOutputPath>
		<Description>Mud.Feishu AI MCP server（可选包）：经 stdio 或 HTTP 上的 JSON-RPC 2.0（tools/list、tools/call、resources/list、resources/read）把已策展的飞书工具面暴露给进程外 Agent；暴露集与 FeishuAgent:Tools / WriteAllowList 注册表白名单同源、不新增任何开关，每个 tool call 仍走既有工具执行链（授权门禁 / 租户切换 / 出站净化 / 审计），租户上下文缺失即 fail-closed，跨租户宿主按每租户一个进程隔离（stdio）或按 appKey 路由（HTTP）；域 guidance 与 per-tool affordance 以 MCP 资源按需下发，文本与 tools/list 逐字节同源。net8.0+ 原生 AOT 兼容。</Description>
		<PackageTags>Feishu;Lark;飞书;MCP;ModelContextProtocol;Agent;AI;Tool;AOT;NativeAOT;MudFeishu</PackageTags>
	</PropertyGroup>

	<ItemGroup>	
		<ProjectReference Include="..\Mud.Feishu.AI\Mud.Feishu.AI.csproj" />
		<ProjectReference Include="..\Mud.Feishu.AI.Tools\Mud.Feishu.AI.Tools.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
		<PackageReference Update="Microsoft.Extensions.Options" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Feishu.AI.Tools.Tests" />
	</ItemGroup>

</Project>
