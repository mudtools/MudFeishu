<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Mud.Feishu.AI.Tools</AssemblyName>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageProjectUrl>http://www.mudtools.cn/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mudtools/MudFeishu</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>Mud.Feishu AI 飞书工具包：把 Bitable/Docx/Wiki/Search/IM/Sheets/Approval 接口经 [FeishuTool] 源生成 Schema 暴露为模型 FunctionCall（含写类工具），内置多租户授权执行链（BeginScope + 授权门禁 + 结果裁剪）与分页/截断/净化出口；流式消息通道、会话事件处理器与 Aily 托管知识问答（RAG-A）自 R-9 起随集成面并入 Mud.Feishu.AI，net8.0+ 原生 AOT 兼容。</Description>
		<PackageTags>Feishu;Lark;飞书;Agent;AI;FunctionCall;Tool;AOT;NativeAOT;MudFeishu</PackageTags>
		<BaseOutputPath>..\bin</BaseOutputPath>
		<!-- Tier R 能力目录（聚合覆盖报告）：只有本包开启——其余引用生成器的工程（AI 底座、测试）
		     跳过全程序集扫描，避免拖累日常编辑的增量构建。 -->
		<FeishuToolCatalog>true</FeishuToolCatalog>
	</PropertyGroup>

	<ItemGroup>
		<!-- 工具描述符 golden 快照（门禁）：源生成器逐字节比对，漂移即 MUDFT014 构建失败。
		     重新固化：以 FeishuToolGoldenUpdate=true 运行 Mud.Feishu.AI.Tools.Tests 的
		     FeishuToolGoldenTests（见该测试类注释）。 -->
		<!-- TEMP-REFREEZE（R-1+2c 重新固化窗口，随后恢复）：构建期 golden 门禁会把「重新固化」本身挡在编译之前
		     （MUDFT014 是 Error 级），故重固化期间临时摘除该 AdditionalFile，改用 FeishuToolGoldenTests
		     的 FeishuToolGoldenUpdate=true 通道写出快照，再恢复本行。 -->
		<AdditionalFiles Include="FeishuToolSchemas.golden.txt" Condition="Exists('FeishuToolSchemas.golden.txt') and '$(FeishuToolRefreeze)' != 'true'" />
		<!-- 域级 guidance 资产（WP6 / AT-F09）：生成器编译期固化为 FeishuToolGuidance.g.cs，
		     装配期只注入「已启用工具所属域」的资产（Mud.Feishu.AI 的 FeishuGuidanceComposer）。
		     素材与该域工具同 repo 同 pass，故不存在"md 与工具面漂移"的面。 -->
		<!-- R5 / F-9：改递归，否则 Guidance/{domain}/{topic}.md（L2 资产）不会进生成器 -->
    <AdditionalFiles Include="Guidance\**\*.md" />
		<!-- 让源生成器经 AnalyzerConfigOptions 读到 FeishuToolCatalog —— MSBuild 属性默认对分析器
		     不可见，缺此声明时生成器读到的是"未设置"，Tier R 能力目录会静默不产出
		     （症状：构建通过但没有 FeishuToolCapabilityCatalog 类型）。 -->
		<CompilerVisibleProperty Include="FeishuToolCatalog" />
	</ItemGroup>

	<ItemGroup>
		<!-- 上层包（DAG 合法层级）：AI（Agent 运行时）+ core（强类型接口载体）+ DataModels（工具出/入 DTO）。
		     实现包（AI/Redis）仅纵向引用 Abstractions；本包为 Phase 1 规划的「工具执行链承载层」，引用 AI + core。 -->
		<ProjectReference Include="..\Mud.Feishu.AI\Mud.Feishu.AI.csproj" />
		<ProjectReference Include="..\Mud.Feishu\Mud.Feishu.csproj" />
		<ProjectReference Include="..\Mud.Feishu.DataModels\Mud.Feishu.DataModels.csproj" />
		<!-- R-9（阶段 5）：EventCallback 引用已摘除——事件处理器/流式通道/知识 Provider 随集成面并入
		     Mud.Feishu.AI，故「只接工具面」的宿主不再被动背上事件 DTO 面（880 个源文件的依赖）。
		     ⚠️ 守卫 AgentContractGuards 断言本集合恰为 {AI, core, DataModels}（+ 生成器分析器），
		     重新加回 EventCallback 会立刻报红。 -->
		<!-- [FeishuTool] 源生成器（已决策⑤ → R-1+2c 上游化）：本地生成器工程已删除，
		     改用组件侧 Mud.HttpUtils.Generator 3.0.5 的通用 ToolSurface 引擎（分析器形态）。
		     工具面规模（条目数 / 签名）不在此处写死数字——数字漂移无法被编译器发现，改为唯一真相源：
		     FeishuToolSchemas.golden.txt 与生成的 FeishuToolContracts（三者一致性由
		     ToolSurfaceScaleContractGuards 机械断言，见 R2-09/G4）。
		     ⚠ 全仓 Mud.HttpUtils* 必须同版本（守卫 TokenMultiAppContractGuards.MudHttpUtils_PackageReference_ShouldBeSingleVersion）。 -->
		<PackageReference Include="Mud.HttpUtils.Generator" Version="3.0.5"
		                  PrivateAssets="all"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false" />
		<!-- 剖面契约：[SdkToolProfile]（数据载体）+ ISdkToolProfile / SdkTokenKind（标记接口与枚举）。
		     见 SdkProfile/FeishuToolProfile.cs —— 旧本地引擎的全部飞书硬编码收拢于此。 -->
		<PackageReference Include="Mud.HttpUtils.Attributes" Version="3.0.5" />
		<PackageReference Include="Mud.HttpUtils.Abstractions" Version="3.0.5" />
	</ItemGroup>

	<ItemGroup>
		<!-- M.E.* 与 Mud.Feishu.AI 同步 Update 到 10.0.11（MAF 1.20.0 传递依赖要求，防 NU1603 版本漂移）。 -->
		<PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
		<PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
		<PackageReference Update="Microsoft.Extensions.Options" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Icon.png" Pack="true" PackagePath="\" />
		<!-- R7 / C6a（§7.3）：Agent Skills 产物随包分发。
		     产物树在**仓库根** skills/（对标官方布局：外部 Agent 按工作区根扫描 skills/{name}/SKILL.md），
		     由 SkillsExportContractTests 守卫其与导出器输出逐字节一致。
		     为什么必须打包：库本身不做文件 IO（Export 返回清单 JSON），若不随包分发，
		     「生态位」就只服务「从仓库取源码」的用户，只装 NuGet 包的人拿不到——这是打包路径存在的唯一理由。
		     ⚠️ PackagePath 末尾的 **反斜杠是必需的**：NuGet 会在"以目录分隔符结尾"的路径后自动追加
		     %(RecursiveDir)；不写分隔符（或写成 skills）时会与递归目录**叠加**成 skills/feishu-ai/feishu-ai/SKILL.md，
		     目录层级翻倍。反过来，若写成 skills\%(Filename)%(Extension) 则会把 21 个域的同名 SKILL.md 拍平覆盖。
		     ⚠️ 守卫：SkillsExportContractTests.Package_ShouldShipSkillsTree 断言本行存在且路径以分隔符结尾
		     （删掉它 ⇒ "只装包的用户拿不到 skills" 这类退化会静默发生）。 -->
		<None Include="..\skills\**\*" Pack="true" PackagePath="skills\" Visible="false" />
	</ItemGroup>

	<!-- R3-11：公共 API 兼容门禁（未发布窗口期零成本建立基线）。 -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="PublicAPI.Shipped.txt" />
		<AdditionalFiles Include="PublicAPI.Unshipped.txt" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Feishu.AI.Tools.Tests" />
	</ItemGroup>

</Project>
