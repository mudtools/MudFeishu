<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>13.0</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>Mud.Feishu.AI.Tools</AssemblyName>
		<!-- R3-01：源生成器宿主惯例——不作为运行时库使用（ReferenceOutputAssembly=false），仅以分析器形态消费。
		     本仓仅 2 个工程以 OutputItemType="Analyzer" 消费该生成器，无第三方宿主自写 [FeishuTool] 接口的场景，
		     故 IsPackable=false（不分发为 NuGet 包），彻底消除"打成 lib 随 CI 全量推送"的缺陷形态。 -->
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<BaseOutputPath>..\bin</BaseOutputPath>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<!-- netstandard2.0 不支持 IsAotCompatible/EnableAotAnalyzer（根 props 为 net8+ 全局开启，此处显式关闭）。 -->
		<IsAotCompatible>false</IsAotCompatible>
		<EnableAotAnalyzer>false</EnableAotAnalyzer>
		<EnableTrimAnalyzer>false</EnableTrimAnalyzer>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- R2-04：分析器发布跟踪（RS2008 的解药）——诊断码的新增/删除/语义变更的**发布账本**。
		     文件名是分析器约定的固定名（Microsoft.CodeAnalysis.Analyzers 按名读取）。 -->
		<AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
		<AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
	</ItemGroup>

</Project>
