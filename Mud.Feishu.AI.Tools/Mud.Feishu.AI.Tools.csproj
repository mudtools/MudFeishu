<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Mud.Feishu.AI.Tools</AssemblyName>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageProjectUrl>http://www.mudtools.cn/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mudtools/MudFeishu</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>Mud.Feishu AI 飞书工具面：把 Mud.Feishu 的强类型接口经 [AgentTool] 源生成 JSON Schema 暴露为模型可调用的 FunctionCall（只读与写类工具，默认全部不启用、按注册表白名单启用），内置授权门禁、风险与身份策略、租户上下文切换、入站拒绝与强制出站脱敏净化、全路径审计，以及分页/截断/结果整形与写工具 dry_run、幂等键；域 guidance 与 per-tool affordance 文档随包导出，供模型与宿主按需取用。Agent 运行时（会话、流式消息通道、知识检索）见 Mud.Feishu.AI。net8.0+ 原生 AOT 兼容。</Description>
		<PackageTags>Feishu;Lark;飞书;Agent;AI;FunctionCall;Tool;AOT;NativeAOT;MudFeishu</PackageTags>
		<BaseOutputPath>..\bin</BaseOutputPath>
		<FeishuToolCatalog>true</FeishuToolCatalog>
	</PropertyGroup>

	<ItemGroup>
		<AdditionalFiles Include="FeishuToolSchemas.golden.txt" Condition="Exists('FeishuToolSchemas.golden.txt') and '$(FeishuToolRefreeze)' != 'true'" />
		<AdditionalFiles Include="Guidance\**\*.md" />
		<AdditionalFiles Include="Affordance\**\*.md" />
		<CompilerVisibleProperty Include="FeishuToolCatalog" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Mud.Feishu.AI\Mud.Feishu.AI.csproj" />
		<ProjectReference Include="..\Mud.Feishu\Mud.Feishu.csproj" />
		<ProjectReference Include="..\Mud.Feishu.DataModels\Mud.Feishu.DataModels.csproj" />

		<PackageReference Include="Mud.AI.Agent" Version="1.0.1" />
		<PackageReference Include="Mud.AI.Generator" Version="1.0.1" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<PackageReference Include="Mud.HttpUtils.Attributes" Version="3.0.8" />
		<PackageReference Include="Mud.HttpUtils.Abstractions" Version="3.0.8" />
	</ItemGroup>

	<ItemGroup>
		<!-- M.E.* 与 Mud.Feishu.AI 同步 Update 到 10.0.12（MAF 1.25.0 传递依赖要求，防 NU1603 版本漂移）。 -->
		<PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
		<PackageReference Update="Microsoft.Extensions.Options" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Icon.png" Pack="true" PackagePath="\" />
		<None Include="..\skills\**\*" Pack="true" PackagePath="skills\" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Feishu.AI.Tools.Tests" />
	</ItemGroup>

</Project>
