<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Mud.Feishu.AI</AssemblyName>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageProjectUrl>http://www.mudtools.cn/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mudtools/MudFeishu</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>Mud.Feishu AI-Native Agent 运行时：基于 Microsoft Agent Framework 的会话管理、模型接入与飞书工具执行链底座；自 R-9 起同时承载飞书 Agent 集成面（流式消息通道、会话事件处理器、Aily 托管知识问答 RAG-A），并因此需要 Mud.Feishu 客户端与 Mud.Feishu.DataModels 程序集。net8.0+ 原生 AOT 兼容。</Description>
		<PackageTags>Feishu;Lark;飞书;Agent;AI;AIAgent;LLM;ChatClient;AOT;NativeAOT;MudFeishu</PackageTags>
		<BaseOutputPath>..\bin</BaseOutputPath>
		<!-- MEAI001：MessageCountingChatReducer 是 MEAI 唯一内置的历史消息计数裁剪器，
		     是 MaxHistoryMessages 的真实消费点；其「实验性」诊断按有意采用抑制（替代方案为自研裁剪器）。 -->
		<NoWarn>$(NoWarn);MEAI001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Mud.Feishu.Abstractions\Mud.Feishu.Abstractions.csproj" />
		<!-- R-9（阶段 5）：飞书 Agent **集成面**（Channels / Events / Knowledge）并入本工程，因此新增三条纵向引用。
		     无环（已核实）：core → {Abstractions, DataModels}，不引用本工程；EventCallback → Abstractions。
		     ⚠️ 本工程**不得**引用 Mud.Feishu.AI.Tools / Mud.Feishu.AI.Mcp（防环；保持"工具面依赖集成面"单向），
		     由 AgentContractGuards 的两条负向断言机械锁定。 -->
		<ProjectReference Include="..\Mud.Feishu\Mud.Feishu.csproj" />
		<ProjectReference Include="..\Mud.Feishu.DataModels\Mud.Feishu.DataModels.csproj" />
		<ProjectReference Include="..\Mud.Feishu.EventCallback\Mud.Feishu.EventCallback.csproj" />
		<!-- R-1+2c：本工程不含任何 [FeishuTool] 接口，也不消费工具面产物（仅 XML 注释提及
		     Mud.Feishu.AI.Tools.Generated）⇒ 迁移到上游引擎后**不再需要**挂分析器引用。
		     工具面生成的剖面（FeishuToolProfile）只属于声明了 [FeishuTool] 的程序集
		     （Mud.Feishu.AI.Tools 与样例测试工程），见该文件注释。 -->
	</ItemGroup>

	<ItemGroup>
		<!-- AI 底座（Microsoft Agent Framework）——全仓单一版本，由契约守卫锁定（见 Tests 契约守卫）。 -->
		<PackageReference Include="Microsoft.Agents.AI" Version="1.20.0" />
		<PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.20.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- MAF 1.20.0 传递依赖要求 M.E.* ≥ 10.0.11：为避免 NU1603 版本漂移，本项目内统一 Update 到该版本
		     （含 netstandard2.0/net6.0——M.E.* 10.x 均提供 ns2.0 兼容资产，根 props 对这两个 TFM 已设
		     SuppressTfmSupportBuildWarnings）。配置绑定走源生成（net8+ 由根 props 启用）。 -->
		<PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
		<PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
		<PackageReference Update="Microsoft.Extensions.Options" Version="10.0.11" />
		<PackageReference Update="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
		<PackageReference Update="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net10.0'">
		<!-- 显式声明（P2-5）：ChatTokenCounter 在 net8+ 直接调用 TiktokenTokenizer 计数，
		     原先依赖 MAF 的传递依赖——直接使用的 API 必须直接声明（否则上游摘除/换实现即静默失效）。
		     版本与 MAF 1.20.0 的传递解析版本一致（2.0.0），避免 NU1603 版本漂移（门禁断言 = 0）。
		     netstandard2.0 / net6.0 走字符估算回退，无此依赖。 -->
		<PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
		<!-- R2-4：Tiktoken 词表数据（EncoderModel "gpt-4o" → o200k_base）是**独立包**。
		     缺失时 TiktokenTokenizer.CreateForModel 抛 InvalidOperationException，
		     被 ChatTokenCounter 的 catch 静默吞掉 ⇒ IsExactCount 恒 false、MaxHistoryTokens 维度
		     全部退化为字符估算且无任何可观测信号（R1 P2-5 残余缺陷）。
		     版本与主包**同版本线**（nuget.org 实核 latestVersion = 2.0.0），避免 NU1603 版本漂移。 -->
		<PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Feishu.AI.Tests" />
		<!-- R-9 / 阶段 5.0（下沉批）：FeishuApiOutcome<T> + FeishuApiResultReader + FeishuToolDiagnostics
		     + FeishuAppContextScopeFactory 从工具面下沉到本工程（保持 internal）。
		     工具面（执行器、FeishuToolBinding、AddFeishuToolInfrastructure）与 Channels/ 实现仍要消费它们
		     ⇒ 用 IVT 而非 public，避免反向扩大公开面。 -->
		<InternalsVisibleTo Include="Mud.Feishu.AI.Tools" />
		<!-- 工具面测试工程：其用例直接断言下沉类型的内部行为（如 FeishuAppContextScopeFactoryTests 的
		     四步门禁），故与 AI.Tests 同等授予。 -->
		<InternalsVisibleTo Include="Mud.Feishu.AI.Tools.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- R-9 下沉批：FeishuAppContextScopeFactory 直接使用 Mud.HttpUtils 的
		     IAppContextHolder / IAppAccessAuthorizer / AppKey——"直接使用的 API 必须直接声明"，
		     避免依赖 Abstractions 的传递引用；版本与全仓**同一条版本线**
		     （守卫 TokenMultiAppContractGuards.MudHttpUtils_PackageReference_ShouldBeSingleVersion 锁定）。 -->
		<PackageReference Include="Mud.HttpUtils" Version="3.0.5" />
	</ItemGroup>

	<!-- R3-11：公共 API 兼容门禁（利用"未发布"窗口期零成本建基线）。 -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="PublicAPI.Shipped.txt" />
		<AdditionalFiles Include="PublicAPI.Unshipped.txt" />
	</ItemGroup>

</Project>
