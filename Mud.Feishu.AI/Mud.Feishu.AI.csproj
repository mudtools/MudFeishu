<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Mud.Feishu.AI</AssemblyName>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageProjectUrl>http://www.mudtools.cn/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mudtools/MudFeishu</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>Mud.Feishu AI Agent 运行时：基于 Microsoft Agent Framework 为飞书落地会话式 Agent，经 AddFeishuAgent 一行接入 DI，提供会话记忆与孤儿审批历史自愈、卡片流式消息通道、飞书 IM 事件到会话的处理器、写类工具的 HITL 人工确认审批管线（宿主授权器为批准状态唯一所有者，租户上下文缺失即 fail-closed）、Aily 托管知识问答（RAG-A）与调用链追踪；策展工具面由 Mud.Feishu.AI.Tools 提供，net8.0+ 原生 AOT 兼容。</Description>
		<PackageTags>Feishu;Lark;飞书;Agent;AI;AIAgent;LLM;ChatClient;AOT;NativeAOT;MudFeishu</PackageTags>
		<BaseOutputPath>..\bin</BaseOutputPath>
		<!-- MEAI001：MessageCountingChatReducer 是 MEAI 唯一内置的历史消息计数裁剪器，
		     是 MaxHistoryMessages 的真实消费点；其「实验性」诊断按有意采用抑制（替代方案为自研裁剪器）。 -->
		<NoWarn>$(NoWarn);MEAI001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Mud.Feishu.Abstractions\Mud.Feishu.Abstractions.csproj" />
		<PackageReference Include="Mud.AI.Agent" Version="1.0.1" />
		<PackageReference Include="Mud.AI.Abstractions" Version="1.0.1" />
		<ProjectReference Include="..\Mud.Feishu\Mud.Feishu.csproj" />
		<ProjectReference Include="..\Mud.Feishu.DataModels\Mud.Feishu.DataModels.csproj" />
		<ProjectReference Include="..\Mud.Feishu.EventCallback\Mud.Feishu.EventCallback.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Agents.AI" Version="1.25.0" />
		<PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.25.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
		<PackageReference Update="Microsoft.Extensions.Options" Version="10.0.12" />
		<PackageReference Update="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
		<PackageReference Update="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Feishu.AI.Tests" />
		<InternalsVisibleTo Include="Mud.Feishu.AI.Tools" />
		<InternalsVisibleTo Include="Mud.Feishu.AI.Tools.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils" Version="3.0.8" />
	</ItemGroup>
</Project>
