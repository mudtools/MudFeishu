<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Mud.Feishu.Abstractions</AssemblyName>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <PackageProjectUrl>http://www.mudtools.cn/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/mudtools/MudFeishu</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageIcon>Icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>飞书服务端 SDK 的 .NET 适配版，支持 .NET Standard 2.0、.NET 6/8/10 平台，net8.0+ 原生 AOT 兼容。提供认证授权、令牌管理、多应用支持与事件订阅处理的抽象层接口。</Description>
        <PackageTags>Feishu;Lark;飞书;ByteDance;字节跳动;Feishu-SDK;Lark-SDK;Feishu-API;Lark-API;Webhook;WebSocket;Event-Subscription;事件订阅;AOT;NativeAOT;MudFeishu</PackageTags>
        <BaseOutputPath>..\bin</BaseOutputPath>
        <!--
          Mud.HttpUtils 2.0.9+：TokenRecoveryOptions 新增接口类型属性 TokenInvalidationDetector
          （ITokenInvalidationDetector，代码级扩展点，宿主以实例注入）。配置绑定源生成器无法为接口类型属性
          生成绑定代码，会在 FeishuServiceCollectionExtensions 的 Configure<TokenRecoveryOptions> 调用点
          产出 SYSLIB1100/SYSLIB1101。该诊断由生成器上报（不参与 #pragma 抑制），且我们刻意保留
          「委托式 Bind」写法以维持 AOT 安全（见该处注释），故在此项目级静默：
          属性不经配置绑定，运行期行为不受影响。
        -->
        <NoWarn>$(NoWarn);SYSLIB1100;SYSLIB1101</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net6.0' or '$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    </ItemGroup>
	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils" Version="3.0.4" />
	</ItemGroup>
    <ItemGroup>
        <PackageReference Include="Mud.HttpUtils.Generator" Version="3.0.4" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <None Include=".\README.md" Pack="true" PackagePath="\" />
        <None Include="..\Icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- AOT 裁剪兜底：保留 FeishuApiResult/FeishuEventHeader/EventData 等核心类型的反射元数据 -->
    <ItemGroup>
        <TrimmerRootDescriptor Include="Mud.Feishu.Abstractions.rd.xml" />
    </ItemGroup>

</Project>
