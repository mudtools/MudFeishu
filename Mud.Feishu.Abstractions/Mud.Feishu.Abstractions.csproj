<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Mud.Feishu.Abstractions</AssemblyName>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <PackageProjectUrl>http://www.mudtools.cn/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/mudtools/MudFeishu</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageIcon>Icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>飞书服务端 SDK 的 .NET 适配版，支持 .NET Standard 2.0、.NET 6/8/10 平台，net8.0+ 原生 AOT 兼容。提供认证授权、令牌管理、多应用支持与事件订阅处理的抽象层接口。</Description>
        <PackageTags>Feishu;Lark;飞书;ByteDance;字节跳动;Feishu-SDK;Lark-SDK;Feishu-API;Lark-API;Webhook;WebSocket;Event-Subscription;事件订阅;AOT;NativeAOT;MudFeishu</PackageTags>
        <BaseOutputPath>..\bin</BaseOutputPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net6.0' or '$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    </ItemGroup>
	<ItemGroup>
		<PackageReference Include="Mud.HttpUtils" Version="3.0.7" />
		<!-- F-9（Mud.HttpUtils 3.0.7 起）：元包不再传递 Mud.HttpUtils.Resilience，弹性策略改为可选包。
		     本工程的 AddFeishuApp 装配链调用 AddMudHttpResilienceDecorator 并构造 ResilienceOptions
		     （per-app 重试/超时/熔断，F-21），故显式安装。
		     该依赖必须随包流传给消费方（AddFeishuApp 运行期加载 Mud.HttpUtils.Resilience.dll），
		     故不得设 PrivateAssets；版本与全仓 Mud.HttpUtils* 单版本守卫保持一致。 -->
		<PackageReference Include="Mud.HttpUtils.Resilience" Version="3.0.7" />
	</ItemGroup>
    <ItemGroup>
        <PackageReference Include="Mud.HttpUtils.Generator" Version="3.0.7" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <None Include=".\README.md" Pack="true" PackagePath="\" />
        <None Include="..\Icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- AOT 裁剪兜底：保留 FeishuApiResult/FeishuEventHeader/EventData 等核心类型的反射元数据 -->
    <ItemGroup>
        <TrimmerRootDescriptor Include="Mud.Feishu.Abstractions.rd.xml" />
    </ItemGroup>

</Project>
