<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Mud.Feishu.Redis</AssemblyName>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageProjectUrl>http://www.mudtools.cn/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mudtools/MudFeishu</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>飞书事件订阅组件 Redis 分布式去重扩展，提供基于 Redis 的事件去重、Nonce 去重和 SeqID 去重功能，适用于多实例分布式部署场景，支持 Native AOT 发布（net8.0+）。</Description>
		<PackageTags>Feishu;Lark;飞书;ByteDance;字节跳动;Feishu-Redis;Lark-Redis;Redis;Event-Deduplication;事件去重;AOT;NativeAOT;MudFeishu</PackageTags>
		<BaseOutputPath>..\bin</BaseOutputPath>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.5" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
        <PackageReference Include="StackExchange.Redis" Version="3.3.0" />
		<!-- F-3 / C-6（Mud.HttpUtils 3.0.7）：引用官方分布式令牌存储包，作为编解码与
		     互操作锚点——FeishuTokenStoreCodec（Abstractions，实现官方 ITokenStoreCodec 双读）
		     可注入官方 RedisTokenStore 的 codec 参数，把官方组件接到飞书形态的存量数据上。
		     注意两种 ITokenStore 使用约定不可互换直插：官方 store 为「明文入参 + store 内部
		     codec 编解码」，飞书管线（桥接器）为「直存编码值」——后者继续由本包的
		     RedisTokenStore / RedisUserTokenStore 承载（对账清单 C-6 分层共存裁决）。
		     SE.Redis 版本差（官方锚定 2.8.24，本包 3.3.0）跨大版本二进制兼容（B-5/B-8）。 -->
		<PackageReference Include="Mud.HttpUtils.Redis" Version="3.0.7" />
	</ItemGroup>		
	<ItemGroup>
		<!-- <PackageReference Include="Mud.Feishu.Abstractions" Version="1.1.2" /> -->
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\Icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Mud.Feishu.Abstractions\Mud.Feishu.Abstractions.csproj" />
		<!-- 治理约束：包间只允许纵向引用（各实现包 → Abstractions），不允许横向引用。
		     会话存储契约（IConversationStore/ConversationKeyBuilder/SessionStoreEncoding/
		     FeishuConversationOptions）位于 Abstractions，本包只依赖契约实现 Redis 后端。 -->
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mud.Feishu.Redis.Tests" />
		<InternalsVisibleTo Include="Mud.Feishu.Redis.IntegrationTests" />
	</ItemGroup>
</Project>
