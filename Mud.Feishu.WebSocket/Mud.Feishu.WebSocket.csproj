<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Mud.Feishu.WebSocket</AssemblyName>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageProjectUrl>http://www.mudtools.cn/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mudtools/MudFeishu</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>适用于 .NET 全平台的飞书 WebSocket 长连接事件订阅组件，提供开箱即用的客户端实现，支持自动重连、心跳检测与事件分发，并基于策略模式构建可扩展的事件处理机制，支持 Native AOT 发布（net8.0+），帮助开发者在 .NET 应用中便捷、可靠地接收和处理飞书实时事件。</Description>
		<PackageTags>Feishu;Lark;飞书;ByteDance;字节跳动;Feishu-SDK;Lark-SDK;Feishu-WebSocket;Lark-WebSocket;WebSocket;Long-Connection;长连接;Event-Subscription;事件订阅;AOT;NativeAOT;MudFeishu</PackageTags>
		<BaseOutputPath>..\bin</BaseOutputPath>
		<!-- protobuf-net AOT 编译期模型（docs.protobuf-net.dev/aot）：触发特性当前为 Experimental（PBN9001），需显式抑制 -->
		<NoWarn>$(NoWarn);PBN9001</NoWarn>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.9" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0' or '$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.1" />
	</ItemGroup>
    <ItemGroup>
    		<PackageReference Include="protobuf-net" Version="3.4.30" />
    </ItemGroup>

	<ItemGroup>
		<!-- <PackageReference Include="Mud.Feishu" Version="1.1.2" />
		<PackageReference Include="Mud.Feishu.Abstractions" Version="1.1.2" /> -->
		<ProjectReference Include="..\Mud.Feishu.Abstractions\Mud.Feishu.Abstractions.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Include=".\README.md" Pack="true" PackagePath="\" />
		<None Include="..\Icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- protobuf-net AOT：模型声明位于 EventProtoData.cs 的 FeishuWebSocketProtoModel（[ProtoModel] + [ProtoSerializable]），
	     序列化调用统一走 FeishuWebSocketProtoModel.Instance，禁止 ProtoBuf.Serializer 静态门面（反射路径，AOT 不可用） -->
</Project>
