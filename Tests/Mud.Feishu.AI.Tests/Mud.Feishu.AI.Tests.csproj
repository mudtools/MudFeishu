<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Mud.Feishu.AI\Mud.Feishu.AI.csproj" />
    <!-- 样例工具接口（本测试工程内）的 [AgentTool] 源生成器：显式挂分析器，样例 Schema 随测试编译产出。
         v2.3 P1-E 起由 Mud.AI.Generator 提供；Mud.AI 家族独立化后改为 NuGet 分析器包形态（跨仓）。
         注意：分析器形态的引用（包或工程）**不会**经 ProjectReference 传递到下游，故此处必须显式声明。
         ⚠ 禁兼引：不得同时引用组件侧 Mud.HttpUtils.Generator（同名 hintName 产物冲突）——
         由 SingleToolSurfaceEngineContractGuards 断言。 -->
    <PackageReference Include="Mud.AI.Generator" Version="1.0.2" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Mud.HttpUtils.Attributes" Version="3.0.9" />
    <PackageReference Include="Mud.HttpUtils.Abstractions" Version="3.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- 剖面必须随编译单元存在（引擎按 Compilation 发现剖面）——链接生产工程的同一份真相源，
         不复制第二份声明。本工程非 owner 程序集，只得到 FeishuToolSchemas（样例工具 Schema）。 -->
    <Compile Include="..\..\Mud.Feishu.AI.Tools\SdkProfile\FeishuToolProfile.cs"
             Link="SdkProfile\FeishuToolProfile.cs" />

    <!-- 受治理文档的位置注册表（测试库资产，生产零引用）：以 Compile Include 链接进两个消费方
         测试工程（本工程 + AI.Tools.Tests），不建共享工程（否则落入 verify-build 步骤 4 的
         "每个 Tests/** 工程必须产出 TRX"断言）、不复制第二份（位置只许一个真相源）。 -->
    <Compile Include="..\Shared\Docs\FeishuDocs.cs"
             Link="Shared\Docs\FeishuDocs.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
  </ItemGroup>

</Project>
