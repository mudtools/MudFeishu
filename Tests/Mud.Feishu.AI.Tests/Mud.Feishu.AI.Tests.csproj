<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Mud.Feishu.AI\Mud.Feishu.AI.csproj" />
    <!-- 样例工具接口（本测试工程内）的 [FeishuTool] 源生成器：显式挂分析器，样例 Schema 随测试编译产出。
         R-1+2c：本地生成器工程已删除，改用组件侧 Mud.HttpUtils.Generator 3.0.3
         的通用 ToolSurface 引擎（分析器形态）。
         注意：包引用形态的分析器**不会**经 ProjectReference 传递到下游，故此处必须显式声明。 -->
    <PackageReference Include="Mud.HttpUtils.Generator" Version="3.0.3"
                      PrivateAssets="all"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <PackageReference Include="Mud.HttpUtils.Attributes" Version="3.0.3" />
    <PackageReference Include="Mud.HttpUtils.Abstractions" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 剖面必须随编译单元存在（引擎按 Compilation 发现剖面）——链接生产工程的同一份真相源，
         不复制第二份声明。本工程非 owner 程序集，只得到 FeishuToolSchemas（样例工具 Schema）。 -->
    <Compile Include="..\..\Mud.Feishu.AI.Tools\SdkProfile\FeishuToolProfile.cs"
             Link="SdkProfile\FeishuToolProfile.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
  </ItemGroup>

</Project>
