<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    SEC-1：显式清空继承源（用户级 / 机器级 nuget.config 中的源不再参与解析），
    使本仓库的包来源集合完全由本文件决定，可静态审计。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Mud.HttpUtils.Local" value="D:/Repos/MudHttpUtils/artifacts" />
  </packageSources>
  <!--
    SEC-1：源映射（packageSourceMapping）。
    规则：
      1) 组件族 Mud.HttpUtils* 同时映射到「本地源 + nuget.org」，本地源在前以保证开发机
         优先解析本地打包产物（与 scripts/verify-build.ps1 的 CACHE-1 新鲜度自检口径一致）。
         注意：**不能**只映射本地源 —— nuget.org 的 Mud.HttpUtils 最高版本为 2.0.2，
         而本仓库精确引用 2.0.5，托管 CI runner 上不存在 D:/Repos/MudHttpUtils/artifacts，
         只映射本地源会让 Restore 直接失败（NU1101）。
      2) nuget.org 以 "*" 兜底其余全部包（含 Microsoft.Extensions.*、xunit 等第三方依赖），
         否则启用映射后未映射的包会无法还原。
  -->
  <packageSourceMapping>
    <packageSource key="Mud.HttpUtils.Local">
      <package pattern="Mud.HttpUtils*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Mud.HttpUtils*" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
